        <mxCell id="subtitle" value="You build AS 65000 (r1+r2). The two ISPs come up automatically. 8.8.8.0/24 is dual-advertised → you pick the path." style="text;html=1;fontSize=13;fontColor=#6B7785;align=left;" vertex="1" parent="1"><mxGeometry x="62" y="62" width="800" height="22" as="geometry" /></mxCell>

